---
// Acerca de: foto del artista en blanco y negro (como fotocopia) con marcas de corte, bio,
// statement, botones y trayectoria a máquina.
import Base from '../layouts/Base.astro'
import Button from '../components/Button.astro'
import ObraImagen from '../components/ObraImagen.astro'
import {getSitio} from '../lib/contenido'

const {contenido} = await getSitio()
const {acerca} = contenido
const cv = acerca.cv.filter((s) => s.entradas.length > 0)
const pie = [acerca.creditoFoto && `Foto: ${acerca.creditoFoto}`, acerca.lugarFoto].filter(Boolean).join(' — ')
---

<Base titulo="Acerca de" seccion="acerca" descripcion={acerca.bioDestacada}>
  <section class="cabecera contenedor">
    <h1 class="titulo-pagina">Acerca de</h1>
  </section>

  <div class:list={['cuerpo contenedor', {'cuerpo--sin-foto': !acerca.foto}]}>
    {
      acerca.foto && (
        <figure class="foto">
          <span class="foto-marco corte">
            <ObraImagen imagen={acerca.foto} sizes="(max-width: 767.98px) 90vw, 480px" eager class="foto-img" />
          </span>
          {pie && <figcaption class="pie">{pie}</figcaption>}
        </figure>
      )
    }

    <div class="texto">
      {acerca.bioDestacada && <p class="bio-destacada">{acerca.bioDestacada}</p>}
      {acerca.bio && <p class="parrafo bio">{acerca.bio}</p>}

      {
        (acerca.statementFrase || acerca.statement) && (
          <section class="statement" aria-labelledby="statement-titulo">
            <h2 id="statement-titulo" class="etiqueta punto">
              Statement
            </h2>
            {acerca.statementFrase && (
              <blockquote class="frase grotesca">
                <p>{acerca.statementFrase}</p>
              </blockquote>
            )}
            {acerca.statement && <p class="parrafo">{acerca.statement}</p>}
          </section>
        )
      }

      <div class="botones">
        <Button href="/contacto">Escribime →</Button>
        {
          acerca.cvPdfUrl && (
            <Button variante="secundario" href={acerca.cvPdfUrl} target="_blank" rel="noopener">
              Descargar CV (PDF) ↓
            </Button>
          )
        }
      </div>
    </div>
  </div>

  {
    cv.length > 0 && (
      <section class="trayectoria contenedor" aria-labelledby="trayectoria-titulo">
        <h2 id="trayectoria-titulo" class="titulo-seccion">
          Trayectoria
        </h2>
        {cv.map((seccion) => (
          <div class="grupo">
            <h3 class="etiqueta grupo-titulo">{seccion.titulo}</h3>
            <ul class="entradas">
              {seccion.entradas.map((e) => (
                <li>
                  <span class="anio num">{e.anio}</span>
                  <span>{e.texto}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )
  }
</Base>

<style>
  .cabecera {
    padding-top: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: clamp(48px, 6vw, 112px);
  }

  .cuerpo--sin-foto {
    grid-template-columns: minmax(0, 1fr);
  }

  .foto {
    position: sticky;
    top: 28px;
  }

  .foto-marco {
    position: relative;
    display: block;
  }

  .foto-marco :global(.foto-img) {
    width: 100%;
    max-height: none;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.12);
  }

  .pie {
    margin-top: 20px;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  .texto {
    max-width: 760px;
  }

  .bio-destacada {
    font-family: var(--grotesca);
    font-stretch: 100%;
    font-weight: 500;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.22;
    letter-spacing: -0.01em;
    white-space: pre-line;
  }

  .bio {
    margin-top: 28px;
    white-space: pre-line;
  }

  .statement {
    margin-top: 64px;
    padding-top: 18px;
    border-top: 1px solid var(--linea);
  }

  .frase {
    margin-top: 20px;
    font-size: clamp(24px, 2.6vw, 40px);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .frase + .parrafo {
    margin-top: 24px;
  }

  .statement .parrafo {
    white-space: pre-line;
  }

  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
  }

  /* Trayectoria */
  .trayectoria {
    margin-top: clamp(112px, 12vw, 176px);
  }

  .trayectoria .titulo-seccion {
    padding-bottom: 22px;
  }

  .grupo {
    display: grid;
    grid-template-columns: minmax(200px, 3fr) minmax(0, 9fr);
    gap: 12px 40px;
    padding: 22px 0;
    border-top: 1px solid var(--linea);
  }

  .grupo-titulo {
    padding-top: 2px;
    color: var(--blanco);
  }

  .entradas li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px;
    padding: 5px 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--gris);
  }

  .anio {
    color: var(--tenue);
  }

  @media (max-width: 1023.98px) {
    .cuerpo {
      grid-template-columns: minmax(0, 1fr);
    }

    .foto {
      position: static;
      max-width: 460px;
    }
  }

  @media (max-width: 767.98px) {
    .statement {
      margin-top: 48px;
    }

    .botones {
      flex-direction: column;
      margin-top: 36px;
    }

    .grupo {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px 0;
    }

    .entradas li {
      grid-template-columns: 56px minmax(0, 1fr);
      font-size: 13px;
    }
  }
</style>
