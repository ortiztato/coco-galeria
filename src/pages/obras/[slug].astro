---
// Página de obra: a la izquierda la obra sobre un panel, con marcas de corte y sus vistas numeradas
// como cuadros de una tira de película (01A, 01B…); la vista elegida queda recuadrada en rojo.
// A la derecha (sticky) la ficha: número, colección, título, datos, descripción y consulta.
// Abajo, anterior / siguiente y "Más de [colección]".
import type {GetStaticPaths} from 'astro'
import Base from '../../layouts/Base.astro'
import DataList from '../../components/DataList.astro'
import Button from '../../components/Button.astro'
import ObraGrid from '../../components/ObraGrid.astro'
import ObraCard from '../../components/ObraCard.astro'
import ObraImagen from '../../components/ObraImagen.astro'
import Marca from '../../components/Marca.astro'
import {getSitio} from '../../lib/contenido'
import {hrefColeccion, hrefObra, medidasTexto} from '../../lib/derivados'
import {dosCifras} from '../../lib/texto'
import type {Vista} from '../../lib/tipos'

export const getStaticPaths = (async () => {
  const {contenido} = await getSitio()
  return contenido.obras.map((obra) => ({params: {slug: obra.slug}, props: {slug: obra.slug}}))
}) satisfies GetStaticPaths

const {slug} = Astro.props
const {contenido, d} = await getSitio()
const obra = contenido.obras.find((o) => o.slug === slug)!
const coleccion = d.coleccionDe(obra)
const {anterior, siguiente} = d.vecinas(obra)
const masDe = coleccion ? d.obrasDe(coleccion.slug).filter((o) => o.slug !== obra.slug) : []
const medidas = medidasTexto(obra)
const numero = d.numero(obra)

// Vistas: la obra completa primero, después detalles / en sala / otras. Código de cuadro: 01A, 01B…
let nDetalle = 0
let nOtra = 0
const etiquetaVista = (v: Vista) => {
  if (v.tipo === 'detalle') return `Detalle ${++nDetalle}`
  if (v.tipo === 'sala') return 'En sala'
  return `Otra vista ${++nOtra}`
}
const vistas = [
  {etiqueta: 'Obra completa', imagen: obra.imagen},
  ...obra.vistas.map((v) => ({etiqueta: etiquetaVista(v), imagen: v.imagen})),
].map((v, i) => ({...v, codigo: `${numero}${String.fromCharCode(65 + (i % 26))}`}))

const datos = [
  ...(obra.anio ? [{etiqueta: 'Año', valor: String(obra.anio)}] : []),
  ...(obra.tecnica ? [{etiqueta: 'Técnica', valor: obra.tecnica}] : []),
  ...(medidas ? [{etiqueta: 'Medidas', valor: medidas}] : []),
  ...(coleccion ? [{etiqueta: 'Colección', valor: coleccion.nombre, href: hrefColeccion(coleccion.slug)}] : []),
]
const descripcion =
  obra.descripcion ??
  `${obra.titulo}${obra.anio ? ` (${obra.anio})` : ''}. ${[obra.tecnica, medidas].filter(Boolean).join(', ')}${obra.tecnica || medidas ? '. ' : ''}Obra de ${contenido.config.nombre}.`
---

<Base titulo={obra.titulo} seccion="obras" descripcion={descripcion} imagen={obra.imagen.src}>
  <div class="barra contenedor">
    <nav class="migas" aria-label="Migas de pan">
      <a href="/">Obras</a>
      {
        coleccion && (
          <>
            <span aria-hidden="true"> / </span>
            <a href={hrefColeccion(coleccion.slug)}>{coleccion.nombre}</a>
          </>
        )
      }
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{obra.titulo}</span>
    </nav>
    <p class="posicion num">
      {numero} / {dosCifras(d.total)}
    </p>
  </div>

  <div class="obra contenedor">
    <section class="visor" aria-label="Imágenes de la obra">
      <div class="pared">
        {
          vistas.map((v, i) => (
            <div class="vista" data-vista={i} hidden={i !== 0}>
              <span class="marco corte">
                <ObraImagen imagen={v.imagen} sizes="(max-width: 767.98px) 100vw, 62vw" eager={i === 0} class="foto" />
              </span>
            </div>
          ))
        }
        <p class="cuadro num" aria-hidden="true" data-cuadro>
          ▸ {vistas[0].codigo}
        </p>
      </div>

      {
        vistas.length > 1 && (
          <div class="selector" role="group" aria-label="Vistas de la obra">
            {vistas.map((v, i) => (
              <button type="button" class="boton-vista" aria-pressed={i === 0 ? 'true' : 'false'} data-ir-a={i} data-codigo={v.codigo}>
                <span class="mini con-marca">
                  <img src={v.imagen.miniatura ?? v.imagen.src} alt="" width="72" height="72" loading="lazy" decoding="async" />
                  <Marca tipo="recuadro" class="marca-vista" />
                </span>
                <span class="codigo num">{v.codigo}</span>
                <span class="nombre-vista">{v.etiqueta}</span>
              </button>
            ))}
          </div>
        )
      }
    </section>

    <aside class="ficha">
      <p class="encabezado">
        <span class="punto num">Nº {numero}</span>
        {obra.imagen.color && <span class="muestra" style={`background:${obra.imagen.color}`} />}
        {coleccion && <a href={hrefColeccion(coleccion.slug)}>{coleccion.nombre}</a>}
      </p>
      <h1 class="titulo grotesca">{obra.titulo}</h1>
      {datos.length > 0 && <DataList datos={datos} class="datos" />}
      {obra.descripcion && <p class="parrafo descripcion">{obra.descripcion}</p>}
      <Button href={`/contacto?obra=${obra.slug}`} class="consultar">Consultar por esta obra →</Button>
    </aside>
  </div>

  {
    (anterior || siguiente) && (
      <nav class="vecinas contenedor" aria-label="Otras obras">
        {anterior && (
          <a href={hrefObra(anterior.slug)} rel="prev" class="ant">
            <span class="dir">← Anterior</span>
            <span class="vec-titulo grotesca">{anterior.titulo}</span>
          </a>
        )}
        {siguiente && (
          <a href={hrefObra(siguiente.slug)} rel="next" class="sig">
            <span class="dir">Siguiente →</span>
            <span class="vec-titulo grotesca">{siguiente.titulo}</span>
          </a>
        )}
      </nav>
    )
  }

  {
    coleccion && masDe.length > 0 && (
      <section class="mas contenedor" aria-labelledby="mas-titulo">
        <div class="mas-head">
          <h2 id="mas-titulo" class="titulo-seccion">
            Más de {coleccion.nombre}
          </h2>
          <a class="ver" href={hrefColeccion(coleccion.slug)}>
            Ver la colección →
          </a>
        </div>
        <ObraGrid variante="mas">
          {masDe.map((o) => (
            <ObraCard obra={d.resumen(o)} variante="mas" />
          ))}
        </ObraGrid>
      </section>
    )
  }
</Base>

<script>
  // Cambio de vista: muestra la imagen elegida y marca el botón con aria-pressed.
  const cuadro = document.querySelector<HTMLElement>('[data-cuadro]')
  document.querySelectorAll<HTMLButtonElement>('[data-ir-a]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const i = boton.dataset.irA
      document.querySelectorAll<HTMLElement>('[data-vista]').forEach((v) => (v.hidden = v.dataset.vista !== i))
      document.querySelectorAll('[data-ir-a]').forEach((b) => b.setAttribute('aria-pressed', String(b === boton)))
      if (cuadro) cuadro.textContent = `▸ ${boton.dataset.codigo ?? ''}`
    })
  })
</script>

<style>
  .barra {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    padding-top: 10px;
    padding-bottom: 22px;
  }

  .posicion {
    flex: none;
    font-size: 12px;
    color: var(--tenue);
  }

  /* Columnas */
  .obra {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(300px, 4fr);
    align-items: start;
    gap: clamp(32px, 5vw, 88px);
  }

  .pared {
    position: relative;
    height: min(80vh, 860px);
    min-height: 460px;
    padding: clamp(40px, 5vw, 84px);
    background: var(--negro-2);
    border: 1px solid var(--linea);
  }

  .vista {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .vista[hidden] {
    display: none;
  }

  .marco {
    position: relative;
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .marco :global(.foto) {
    max-height: calc(min(80vh, 860px) - 2 * clamp(40px, 5vw, 84px));
  }

  .cuadro {
    position: absolute;
    right: 14px;
    bottom: 10px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--tenue);
  }

  .selector {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 22px;
  }

  .boton-vista {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 72px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--tenue);
    font-size: 11px;
    line-height: 1.3;
    text-align: left;
  }

  .mini {
    display: block;
    width: 72px;
    height: 72px;
  }

  .mini img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    background: var(--negro-3);
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .mini :global(.marca-vista) {
    display: none;
    top: -7px;
    left: -7px;
    width: calc(100% + 14px);
    height: calc(100% + 14px);
  }

  .codigo {
    letter-spacing: 0.08em;
  }

  .nombre-vista {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .boton-vista:hover {
    color: var(--blanco);
  }

  .boton-vista:hover .mini img,
  .boton-vista[aria-pressed='true'] .mini img {
    opacity: 1;
  }

  .boton-vista[aria-pressed='true'] {
    color: var(--blanco);
  }

  .boton-vista[aria-pressed='true'] .mini :global(.marca-vista) {
    display: block;
  }

  /* Ficha */
  .ficha {
    position: sticky;
    top: 28px;
  }

  .encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .titulo {
    margin-top: 22px;
    font-size: clamp(34px, 3.6vw, 60px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
  }

  .ficha :global(.datos) {
    margin-top: 32px;
  }

  .descripcion {
    margin-top: 28px;
  }

  .ficha :global(.consultar) {
    margin-top: 32px;
  }

  /* Anterior / siguiente */
  .vecinas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(72px, 9vw, 128px);
  }

  .vecinas a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--linea);
    text-decoration: none;
  }

  .vecinas .sig {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .dir {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  .vec-titulo {
    font-size: clamp(20px, 2.4vw, 34px);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .vecinas a:hover .vec-titulo {
    text-decoration: underline;
    text-decoration-color: var(--rojo);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.18em;
  }

  /* Más de esta colección */
  .mas {
    margin-top: clamp(112px, 12vw, 176px);
  }

  .mas-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px 32px;
    margin-bottom: 48px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--linea);
  }

  .ver {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1023.98px) {
    .obra {
      grid-template-columns: 1fr;
    }

    .ficha {
      position: static;
    }
  }

  @media (max-width: 767.98px) {
    .barra {
      padding-bottom: 14px;
    }

    .obra {
      gap: 32px;
    }

    .pared {
      height: min(64vh, 520px);
      min-height: 320px;
      margin-inline: calc(var(--gutter) * -1);
      padding: 32px var(--gutter);
      border-inline: 0;
    }

    .marco :global(.foto) {
      max-height: calc(min(64vh, 520px) - 64px);
    }

    .selector {
      gap: 16px;
    }

    .boton-vista {
      width: 64px;
      min-height: 44px;
      font-size: 10px;
    }

    .mini,
    .mini img {
      width: 64px;
      height: 64px;
    }

    .vecinas {
      gap: 16px;
    }

    .mas-head {
      display: block;
    }

    .ver {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-top: 4px;
    }
  }
</style>
