---
import Base from '../layouts/Base.astro'
import {sitio} from '../lib/sitio'

// Por ahora sólo el layout. El hero, el filtro y la grilla llegan en el paso 4.
const marquesina = [sitio.nombre, 'Obra 2020—2024', `${sitio.totalObras} obras · ${sitio.totalColecciones} colecciones`]
---

<Base seccion="obras" marquesina={marquesina} />
