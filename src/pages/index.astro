---
// Home: hero con el nombre, filtro por colección (en el cliente, sin recargar) y grilla de todas las obras.
import Base from '../layouts/Base.astro'
import Overprint from '../components/Overprint.astro'
import FilterChips from '../components/FilterChips.astro'
import ObraGrid from '../components/ObraGrid.astro'
import ObraCard from '../components/ObraCard.astro'
import {getSitio} from '../lib/contenido'
import {partirEnDos} from '../lib/texto'

const {contenido, d} = await getSitio()
const {obras, config} = contenido

const filtros = [
  {valor: 'todas', label: 'Todas', conteo: obras.length},
  ...d.coleccionesConObras.map((c) => ({valor: c.slug, label: c.nombre, conteo: d.obrasDe(c.slug).length})),
]
const lugar = ['Artista visual', config.ciudad].filter(Boolean).join(' · ')
---

<Base seccion="obras" marquesina={d.marquesina.home} descripcion={config.seoDescripcion}>
  <section class="hero">
    <Overprint
      as="h1"
      text={config.nombre}
      mobileText={partirEnDos(config.nombre)}
      size="clamp(210px, 28vw, 410px)"
      height="clamp(210px, 27.5vw, 400px)"
      mobileSize="120px"
      mobileHeight="248px"
    />
    <div class="linea">
      <span>{lugar}</span>
      {
        d.periodoGeneral && (
          <span class="acid">
            <span class="solo-desktop">Obra </span>
            {d.periodoGeneral}
          </span>
        )
      }
      {config.disciplinas && <span class="solo-desktop">{config.disciplinas}</span>}
    </div>
  </section>

  {
    d.coleccionesConObras.length > 1 && (
      <div class="filtros">
        <FilterChips id="filtro-obras" etiqueta="Filtrar por colección" etiquetaVisible="Filtrar" opciones={filtros} />
        <a class="ver-colecciones" href="/colecciones">Ver colecciones →</a>
      </div>
    )
  }

  <ObraGrid id="obras">
    {obras.map((o, i) => <ObraCard obra={d.resumen(o)} eager={i === 0} />)}
  </ObraGrid>
</Base>

<script>
  // Filtro por colección: oculta las tarjetas de otras colecciones y guarda la elección en la URL (?coleccion=…).
  const chips = document.getElementById('filtro-obras')
  const tarjetas = document.querySelectorAll<HTMLElement>('#obras [data-coleccion]')

  function filtrar(valor: string) {
    tarjetas.forEach((t) => (t.hidden = valor !== 'todas' && t.dataset.coleccion !== valor))
    const url = new URL(location.href)
    if (valor === 'todas') url.searchParams.delete('coleccion')
    else url.searchParams.set('coleccion', valor)
    history.replaceState(null, '', url)
  }

  chips?.addEventListener('chips:cambio', (e) => filtrar((e as CustomEvent<{valor: string}>).detail.valor))

  // Si se llega con ?coleccion=… (o volviendo atrás), se aplica al cargar.
  const inicial = new URLSearchParams(location.search).get('coleccion')
  const chipInicial = inicial ? chips?.querySelector<HTMLButtonElement>(`.chip[data-valor="${CSS.escape(inicial)}"]`) : null
  chipInicial?.click()
</script>

<style>
  .hero {
    padding: 20px var(--gutter) 0;
  }

  .linea {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 16px 0;
    border-top: 2px solid var(--text);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .acid {
    color: var(--acid);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 20px var(--gutter);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .ver-colecciones {
    margin-left: auto;
    font-size: 13px;
    font-weight: 700;
    color: var(--acid);
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 767.98px) {
    .hero {
      padding: 14px var(--gutter) 0;
    }

    .linea {
      flex-wrap: nowrap;
      padding: 10px 0;
      font-size: 11px;
    }

    .solo-desktop,
    .ver-colecciones {
      display: none;
    }

    .filtros {
      display: block;
      padding: 12px 0 12px var(--gutter);
    }
  }
</style>
