---
// Contacto: a la izquierda email, Instagram, taller y representación; a la derecha el formulario.
// El motivo cambia la etiqueta del tercer campo. Con ?obra=<slug> se precarga la obra.
// El envío va a Web3Forms con fetch (sin backend): validación nativa, honeypot antispam y
// estados enviando / enviado / error. El motivo y la referencia viajan en el asunto del email.
import Base from '../layouts/Base.astro'
import FilterChips from '../components/FilterChips.astro'
import Button from '../components/Button.astro'
import Marca from '../components/Marca.astro'
import {getSitio} from '../lib/contenido'
import {instagramUrl} from '../lib/sitio'

const {contenido} = await getSitio()
const {config, obras} = contenido
const taller = [config.ciudad, config.pais].filter(Boolean).join(', ')

const motivos = [
  {valor: 'obra', label: 'Consulta por una obra', campo: 'Obra', placeholder: 'Ej.: Umbral rojo, 2023'},
  {valor: 'expo', label: 'Exposiciones', campo: 'Espacio / proyecto', placeholder: 'Nombre del espacio o del proyecto'},
  {valor: 'prensa', label: 'Prensa', campo: 'Medio', placeholder: 'Nombre del medio'},
]
// Para precargar "Título, año" a partir del slug de la URL.
const obrasPorSlug = Object.fromEntries(obras.map((o) => [o.slug, `${o.titulo}, ${o.anio}`]))
---

<Base titulo="Contacto" seccion="contacto" footer="corto">
  <section class="cabecera contenedor">
    <p class="etiqueta punto">Consultas — exposiciones — prensa</p>
    <h1 class="titulo-pagina">Contacto</h1>
    <p class="parrafo intro">Para consultas sobre obras, exposiciones o prensa. También podés escribir directo al mail.</p>
  </section>

  <div class="cuerpo contenedor">
    <dl class="datos">
      {
        config.email && (
          <div class="dato">
            <dt>Email</dt>
            <dd>
              <a class="grande grotesca" href={`mailto:${config.email}`}>
                {config.email}
              </a>
            </dd>
          </div>
        )
      }
      {
        config.instagram && (
          <div class="dato">
            <dt>Instagram</dt>
            <dd>
              <a class="grande grotesca" href={instagramUrl(config.instagram)} target="_blank" rel="noopener">
                @{config.instagram} ↗
              </a>
            </dd>
          </div>
        )
      }
      {
        taller && (
          <div class="dato">
            <dt>Taller</dt>
            <dd>
              <span class="grande grotesca">{taller}</span>
              {config.notaTaller && <span class="nota">{config.notaTaller}</span>}
            </dd>
          </div>
        )
      }
      {
        config.representacion && (
          <div class="dato">
            <dt>Representación</dt>
            <dd class="grande grotesca">{config.representacion}</dd>
          </div>
        )
      }
    </dl>

    <div class="col-form">
      <form
        class="form"
        data-form
        data-obras={JSON.stringify(obrasPorSlug)}
        data-motivos={JSON.stringify(motivos)}
        data-sitio={config.nombre}
      >
        <fieldset class="motivo">
          <legend class="etiqueta">Motivo</legend>
          <FilterChips id="motivo" etiqueta="Motivo del mensaje" envolver opciones={motivos.map(({valor, label}) => ({valor, label}))} />
          <input type="hidden" name="motivo" value={motivos[0].label} data-motivo />
        </fieldset>

        <!-- Honeypot: invisible para las personas; si un bot lo marca, Web3Forms descarta el envío. -->
        <input type="checkbox" name="botcheck" class="trampa" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="fila">
          <label class="campo">
            <span class="etiqueta">Nombre</span>
            <input class="field" type="text" name="nombre" autocomplete="name" placeholder="Tu nombre" required />
          </label>
          <label class="campo">
            <span class="etiqueta">Email</span>
            <input class="field" type="email" name="email" autocomplete="email" placeholder="tu@email.com" required />
          </label>
        </div>

        <label class="campo">
          <span class="etiqueta" data-campo-label>{motivos[0].campo}</span>
          <input class="field" type="text" name="referencia" placeholder={motivos[0].placeholder} data-campo />
        </label>

        <label class="campo">
          <span class="etiqueta">Mensaje</span>
          <textarea class="field" name="mensaje" rows="6" placeholder="Escribí tu mensaje" required></textarea>
        </label>

        <div class="enviar">
          <Button type="submit" tamano="lg" class="boton-enviar" data-enviar>Enviar mensaje →</Button>
          <span class="aviso">Respondo en unos días. Tus datos no se usan para nada más.</span>
        </div>

        <p class="error" role="alert" hidden data-error>
          No se pudo enviar el mensaje. Probá de nuevo en un rato{config.email && <> o escribime a <a href={`mailto:${config.email}`}>{config.email}</a></>}.
        </p>
      </form>

      <div class="enviado" role="status" tabindex="-1" hidden data-enviado>
        <p class="gracias grotesca">
          <span class="con-marca">Gracias<Marca tipo="circulo" class="marca-gracias" /></span>
        </p>
        <p class="parrafo">Mensaje enviado. Te respondo a la brevedad al email que dejaste.</p>
        <div class="enviado-botones">
          <Button href="/">Volver a las obras →</Button>
          <Button variante="secundario" data-otro>Escribir otro mensaje</Button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  type Motivo = {valor: string; label: string; campo: string; placeholder: string}

  const form = document.querySelector<HTMLFormElement>('[data-form]')!
  const enviado = document.querySelector<HTMLElement>('[data-enviado]')!
  const chips = document.getElementById('motivo')!
  const motivoInput = form.querySelector<HTMLInputElement>('[data-motivo]')!
  const campo = form.querySelector<HTMLInputElement>('[data-campo]')!
  const campoLabel = form.querySelector<HTMLElement>('[data-campo-label]')!
  const motivos: Motivo[] = JSON.parse(form.dataset.motivos ?? '[]')
  const obras: Record<string, string> = JSON.parse(form.dataset.obras ?? '{}')

  // El motivo cambia la etiqueta y el ejemplo del tercer campo.
  function aplicarMotivo(valor: string) {
    const m = motivos.find((x) => x.valor === valor)
    if (!m) return
    motivoInput.value = m.label
    campoLabel.textContent = m.campo
    campo.placeholder = m.placeholder
  }
  chips.addEventListener('chips:cambio', (e) => aplicarMotivo((e as CustomEvent<{valor: string}>).detail.valor))

  // ?obra=<slug> → motivo "Consulta por una obra" y el título de la obra precargado.
  const slug = new URLSearchParams(location.search).get('obra')
  if (slug && obras[slug]) {
    chips.querySelector<HTMLButtonElement>('.chip[data-valor="obra"]')?.click()
    aplicarMotivo('obra')
    campo.value = obras[slug]
  }

  // Envío a Web3Forms. La access key es pública por diseño (sólo permite mandar mails a la casilla configurada).
  const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY
  const boton = form.querySelector<HTMLButtonElement>('[data-enviar]')!
  const textoBoton = boton.textContent
  const error = form.querySelector<HTMLElement>('[data-error]')!

  function setEnviando(enviando: boolean) {
    boton.disabled = enviando
    boton.textContent = enviando ? 'Enviando…' : textoBoton
    form.setAttribute('aria-busy', String(enviando))
  }

  function mostrarEnviado() {
    form.hidden = true
    enviado.hidden = false
    enviado.focus()
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    error.hidden = true
    if (!form.reportValidity()) return

    const datos = new FormData(form)
    // Si el honeypot está marcado es un bot: se simula el éxito sin mandar nada.
    if (datos.get('botcheck')) return mostrarEnviado()

    const motivo = String(datos.get('motivo') ?? '')
    const referencia = String(datos.get('referencia') ?? '').trim()
    const etiquetaReferencia = campoLabel.textContent ?? 'Referencia'
    const nombre = String(datos.get('nombre') ?? '').trim()

    setEnviando(true)
    try {
      if (!ACCESS_KEY) throw new Error('Falta PUBLIC_WEB3FORMS_KEY')
      const respuesta = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', Accept: 'application/json'},
        body: JSON.stringify({
          access_key: ACCESS_KEY,
          subject: `${motivo}${referencia ? `: ${referencia}` : ''} — ${nombre}`,
          from_name: `Sitio web de ${form.dataset.sitio ?? ''}`.trim(),
          botcheck: false,
          Nombre: nombre,
          email: String(datos.get('email') ?? '').trim(),
          Motivo: motivo,
          ...(referencia ? {[etiquetaReferencia]: referencia} : {}),
          Mensaje: String(datos.get('mensaje') ?? ''),
        }),
      })
      const resultado = await respuesta.json().catch(() => ({}))
      if (!respuesta.ok || !resultado.success) throw new Error(resultado.message || `HTTP ${respuesta.status}`)
      mostrarEnviado()
    } catch (err) {
      console.error('Error al enviar el formulario:', err)
      error.hidden = false
    } finally {
      setEnviando(false)
    }
  })

  enviado.querySelector('[data-otro]')?.addEventListener('click', () => {
    form.reset()
    chips.querySelector<HTMLButtonElement>('.chip[data-valor="obra"]')?.click()
    aplicarMotivo('obra')
    enviado.hidden = true
    form.hidden = false
    form.querySelector<HTMLInputElement>('input[name="nombre"]')?.focus()
  })
</script>

<style>
  .cabecera {
    padding-top: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  .cabecera .titulo-pagina {
    margin-top: 18px;
  }

  .intro {
    max-width: 48ch;
    margin-top: 26px;
  }

  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: clamp(40px, 6vw, 112px);
  }

  .cuerpo > * {
    padding-top: 28px;
    border-top: 1px solid var(--linea);
  }

  /* Datos de contacto */
  .dato {
    padding: 18px 0;
    border-bottom: 1px solid var(--linea);
  }

  .dato:first-child {
    padding-top: 0;
  }

  .dato:last-child {
    border-bottom: 0;
  }

  dt {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  .grande {
    display: block;
    margin-top: 8px;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  a.grande {
    text-decoration: none;
  }

  a.grande:hover {
    text-decoration: underline;
    text-decoration-color: var(--rojo);
    text-decoration-thickness: 3px;
  }

  .nota {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--gris);
  }

  /* Formulario */
  .form {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 780px;
  }

  .form[hidden],
  .enviado[hidden] {
    display: none;
  }

  .motivo {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
  }

  .fila {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 32px;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .field {
    width: 100%;
    min-height: 52px;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid var(--linea-fuerte);
    border-radius: 0;
    background: transparent;
    color: var(--blanco);
    font-family: var(--mono);
    font-size: 16px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .field:focus {
    outline: none;
    border-bottom-color: var(--rojo);
    box-shadow: 0 1px 0 var(--rojo);
  }

  .field::placeholder {
    color: var(--tenue);
    opacity: 0.8;
  }

  textarea.field {
    resize: vertical;
    line-height: 1.6;
  }

  .enviar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 8px;
  }

  .aviso {
    font-size: 12px;
    color: var(--tenue);
  }

  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .error {
    padding: 14px 16px;
    border-left: 3px solid var(--rojo);
    background: var(--negro-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .error[hidden] {
    display: none;
  }

  /* Enviado */
  .enviado {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 780px;
  }

  .enviado:focus {
    outline: none;
  }

  .gracias {
    padding: 0.3em 0.6em 0.2em;
    font-size: clamp(52px, 7vw, 120px);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .gracias > span {
    display: inline-block;
  }

  .gracias :global(.marca-gracias) {
    stroke-width: 3px;
  }

  .enviado-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 1023.98px) {
    .cuerpo {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 767.98px) {
    .cuerpo {
      gap: 48px;
    }

    .cuerpo > * {
      padding-top: 24px;
    }

    .fila {
      grid-template-columns: 1fr;
    }

    .form {
      gap: 24px;
    }

    .enviar :global(.boton-enviar) {
      display: flex;
      width: 100%;
    }

    .enviado-botones {
      flex-direction: column;
    }
  }
</style>
