---
// Página temporal de desarrollo: muestra todos los componentes (como design/screenshots/sistema.png).
// Se borra antes del deploy (paso 8).
import Base from '../../layouts/Base.astro'
import Overprint from '../../components/Overprint.astro'
import Marquee from '../../components/Marquee.astro'
import ObraCard from '../../components/ObraCard.astro'
import ObraGrid from '../../components/ObraGrid.astro'
import FilterChips from '../../components/FilterChips.astro'
import ListRow from '../../components/ListRow.astro'
import DataList from '../../components/DataList.astro'
import Button from '../../components/Button.astro'
import ObraImagen from '../../components/ObraImagen.astro'
import {imagenPrueba} from '../../lib/prueba'
import {colorFila, type ObraResumen} from '../../lib/tipos'

const obras: ObraResumen[] = [
  {titulo: 'Umbral rojo', anio: 2023, tecnica: 'Óleo sobre tela', col: 'Campos de color', img: 'w01.jpg'},
  {titulo: 'Horizonte gris', anio: 2024, tecnica: 'Óleo sobre tela', col: 'Horizontes', img: 'w05.jpg'},
  {titulo: 'Composición con sol', anio: 2024, tecnica: 'Óleo sobre lino', col: 'Formas', img: 'w03.jpg'},
  {titulo: 'Vertical ocre', anio: 2021, tecnica: 'Técnica mixta sobre papel', col: 'Papeles', img: 'w04.jpg'},
].map((o, i) => ({
  href: '#',
  titulo: o.titulo,
  anio: o.anio,
  tecnica: o.tecnica,
  numero: String(i + 1).padStart(2, '0'),
  coleccion: {nombre: o.col, slug: o.col.toLowerCase().replace(/\s+/g, '-')},
  imagen: imagenPrueba(o.img, o.titulo),
}))

const paleta = [
  {nombre: 'Fondo', valor: '#0A0A0A + grano', css: 'var(--bg)', borde: true},
  {nombre: 'Marco de obra', valor: '#121212', css: 'var(--frame)', borde: true},
  {nombre: 'Línea', valor: '#262626', css: 'var(--line)'},
  {nombre: 'Texto', valor: '#F2F2F2 / #A3A3A3', css: 'var(--text)'},
  {nombre: 'Rosa — tinta 1', valor: '#FF48B0 · activo', css: 'var(--pink)'},
  {nombre: 'Cian — tinta 2', valor: '#00B3FF · colección', css: 'var(--cyan)'},
  {nombre: 'Ácido — señal', valor: '#C6FF00 · nav, marquesina', css: 'var(--acid)'},
]

const colecciones = [
  {nombre: 'Campos de color', meta: '04 obras · 2020—2023', imgs: ['w01.jpg', 'w06.jpg', 'w10.jpg', 'w12.jpg']},
  {nombre: 'Horizontes', meta: '03 obras · 2022—2024', imgs: ['w05.jpg', 'w07.jpg', 'w02.jpg']},
]
---

<Base titulo="Componentes" marquesina={['Sistema visual', 'Componentes', 'Sólo desarrollo']}>
  <div class="dev">
    <header class="titulo">
      <h1 class="display">Sistema visual — Cartel</h1>
      <p class="label">Negro con grano · dos tintas en screen · un ácido para señalar</p>
    </header>

    <section>
      <h2 class="label rosa">Paleta</h2>
      <div class="paleta">
        {
          paleta.map((p) => (
            <div>
              <div class:list={['muestra', {borde: p.borde}]} style={`background:${p.css}`} />
              <div class="label">{p.nombre}</div>
              <div class="valor">{p.valor}</div>
            </div>
          ))
        }
        <div>
          <div class="muestra borde op">
            <Overprint text="AB" size="110px" height="96px" offset={[10, 8]} mobileOffset={[10, 8]} />
          </div>
          <div class="label">Sobreimpresión</div>
          <div class="valor">rosa + cian en screen</div>
        </div>
      </div>
    </section>

    <section>
      <h2 class="label rosa">Tipografías</h2>
      <p class="display six">Six Caps — títulos</p>
      <p class="mono700">JetBrains Mono 700 — Etiquetas</p>
      <p class="mono400">JetBrains Mono 400 — Textos y descripciones</p>
      <p class="cuerpo">
        Texto corrido: 15 px en desktop y 13 px en mobile, interlineado 1.7, color de párrafo y ancho máximo de unos
        680 px para que se lea cómodo.
      </p>
    </section>

    <section>
      <h2 class="label rosa">Overprint (título sobreimpreso)</h2>
      <p class="nota">Una línea, tamaño del hero de colección (alto calculado):</p>
      <Overprint text="Campos de color" size="clamp(210px, 26vw, 380px)" height="clamp(210px, 25.5vw, 370px)" mobileText={['Campos', 'de color']} mobileSize="112px" mobileHeight="220px" />
      <div class="linea"></div>
      <p class="nota">Dos líneas, título de obra (160 px / 100 px mobile):</p>
      <Overprint as="h2" text={['Umbral', 'rojo']} size="160px" mobileSize="100px" offset={[12, 10]} />
      <div class="linea"></div>
    </section>

    <section>
      <h2 class="label rosa">Marquesina</h2>
      <Marquee items={['Marquesina', 'Nombre', 'Obra 2020—2024', '12 obras']} />
    </section>

    <section>
      <h2 class="label rosa">Chips, botones y nav</h2>
      <div class="fila-comp">
        <FilterChips
          etiqueta="Filtrar por colección"
          etiquetaVisible="Filtrar"
          opciones={[
            {valor: 'todas', label: 'Todas', conteo: 12},
            {valor: 'campos', label: 'Campos de color', conteo: 4},
            {valor: 'horizontes', label: 'Horizontes', conteo: 3},
          ]}
        />
      </div>
      <div class="fila-comp">
        <Button>Botón primario →</Button>
        <Button variante="rosa" href="#">Consultar por esta obra →</Button>
        <Button variante="secundario">Secundario</Button>
        <Button tamano="lg">Enviar mensaje →</Button>
        <span class="nav-demo"><span class="acid">[Nav activa]</span> Nav</span>
      </div>
    </section>

    <section class="sangre">
      <h2 class="label rosa pad">Tarjetas de obra — home (360 px)</h2>
      <ObraGrid>
        {obras.map((o, i) => <ObraCard obra={o} eager={i === 0} />)}
      </ObraGrid>
    </section>

    <section class="sangre">
      <h2 class="label rosa pad">Tarjetas de obra — colección (520 px)</h2>
      <ObraGrid variante="coleccion" bordeSuperior>
        {obras.slice(0, 2).map((o) => <ObraCard obra={o} variante="coleccion" />)}
      </ObraGrid>
    </section>

    <section class="sangre">
      <h2 class="label rosa pad">Tarjetas de obra — más de esta colección (280 px)</h2>
      <ObraGrid variante="mas" bordeSuperior>
        {obras.slice(0, 3).map((o) => <ObraCard obra={o} variante="mas" />)}
      </ObraGrid>
    </section>

    <section class="sangre">
      <h2 class="label rosa pad">Filas de listado — colecciones</h2>
      <div class="lista">
        {
          colecciones.map((c, i) => (
            <ListRow
              href="#"
              nombre={c.nombre}
              meta={c.meta}
              numero={String(i + 1).padStart(2, '0')}
              color={colorFila(i)}
              miniaturas={c.imgs.map((f) => imagenPrueba(f))}
            />
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="label rosa">Filas compactas — otras colecciones</h2>
      <div>
        <ListRow variante="compacta" href="#" nombre="Horizontes" meta="03 obras" />
        <ListRow variante="compacta" href="#" nombre="Formas" meta="03 obras" color="cian" />
        <ListRow variante="compacta" href="#" nombre="Papeles" meta="02 obras" />
      </div>
    </section>

    <section class="dos-col">
      <div>
        <h2 class="label rosa">Datos de la obra</h2>
        <DataList
          datos={[
            {etiqueta: 'Año', valor: '2023'},
            {etiqueta: 'Técnica', valor: 'Óleo sobre tela'},
            {etiqueta: 'Medidas', valor: '160 × 120 cm'},
            {etiqueta: 'Colección', valor: 'Campos de color', href: '#', color: 'cian'},
          ]}
        />
      </div>
      <div>
        <h2 class="label rosa">Sombra de registro</h2>
        <div class="registro">
          <span class="marco-reg"><ObraImagen imagen={imagenPrueba('w01.jpg', 'Umbral rojo')} class="con-registro" /></span>
          <p class="nota">
            Cian abajo-derecha, rosa arriba-izquierda. Sólo en la imagen principal de la página de obra y en la foto
            del artista. El resto de las imágenes van limpias.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .dev {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 40px 0 24px;
  }

  section,
  .titulo {
    padding: 0 var(--gutter);
  }

  section.sangre {
    padding: 0;
  }

  .pad {
    padding: 0 var(--gutter);
  }

  h2.label {
    margin-bottom: 12px;
    font-size: 13px;
  }

  .rosa {
    color: var(--pink);
  }

  .acid {
    color: var(--acid);
  }

  .titulo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px 24px;
  }

  .titulo h1 {
    font-size: 96px;
    line-height: 0.85;
  }

  .titulo p {
    color: var(--muted);
    font-size: 13px;
  }

  .titulo::after {
    content: '';
    flex-basis: 100%;
    border-bottom: 2px solid var(--text);
  }

  .paleta {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }

  .muestra {
    height: 96px;
    margin-bottom: 8px;
  }

  .muestra.borde {
    border: 1px solid var(--line-strong);
  }

  .muestra.op {
    position: relative;
    overflow: hidden;
    padding: 6px 14px;
    background: var(--bg);
  }

  .valor,
  .nota {
    font-size: 12px;
    color: var(--muted);
  }

  .nota {
    margin-bottom: 12px;
    line-height: 1.7;
  }

  .six {
    font-size: 120px;
    line-height: 0.85;
  }

  .mono700 {
    margin-top: 14px;
    font-size: 26px;
    font-weight: 700;
  }

  .mono400 {
    font-size: 18px;
  }

  .cuerpo {
    max-width: 680px;
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-body);
  }

  .linea {
    margin: 0 0 24px;
    border-top: 2px solid var(--text);
  }

  .fila-comp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .nav-demo {
    margin-left: 12px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .lista {
    border-top: 2px solid var(--text);
  }

  .dos-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 48px;
  }

  .registro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }

  .marco-reg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 160px;
    height: 160px;
    padding: 24px;
    background: var(--frame);
  }

  .marco-reg :global(.con-registro) {
    box-shadow: 8px 8px 0 var(--cyan), -8px -8px 0 var(--pink);
  }

  .registro .nota {
    flex: 1 1 260px;
    max-width: 520px;
  }

  @media (max-width: 767.98px) {
    .titulo h1 {
      font-size: 64px;
    }

    .six {
      font-size: 72px;
    }

    .mono700 {
      font-size: 18px;
    }

    .mono400 {
      font-size: 14px;
    }

    .cuerpo {
      font-size: 13px;
    }
  }
</style>
