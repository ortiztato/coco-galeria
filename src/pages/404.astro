---
// Página 404 con el estilo del sitio.
import Base from '../layouts/Base.astro'
import Overprint from '../components/Overprint.astro'
import Button from '../components/Button.astro'
---

<Base titulo="Página no encontrada" marquesina={['Página no encontrada', '404', 'Volvé a las obras']} noindex>
  <section class="nf">
    <Overprint as="h1" text="404" size="clamp(210px, 26vw, 380px)" height="clamp(210px, 25.5vw, 370px)" mobileSize="150px" mobileHeight="150px" />
    <div class="cuerpo">
      <p class="texto">Esta página no existe o cambió de lugar.</p>
      <div class="botones">
        <Button variante="primario" href="/">Ver las obras →</Button>
        <Button variante="secundario" href="/contacto">Contacto</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: 24px var(--gutter) 40px;
  }

  .cuerpo {
    padding-top: 20px;
    border-top: 2px solid var(--text);
  }

  .texto {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-body);
  }

  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
</style>
