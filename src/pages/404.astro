---
// Página 404: el número tachado con lápiz rojo.
import Base from '../layouts/Base.astro'
import Button from '../components/Button.astro'
import Marca from '../components/Marca.astro'
---

<Base titulo="Página no encontrada" noindex>
  <section class="nf contenedor">
    <p class="etiqueta punto">Error</p>
    <h1 class="titulo-pagina">
      <span class="con-marca numero">404<Marca tipo="cruz" /></span>
      <span class="sr-only">Página no encontrada</span>
    </h1>
    <p class="parrafo texto">Esta página no existe o la obra cambió de lugar.</p>
    <div class="botones">
      <Button href="/">Ver las obras →</Button>
      <Button variante="secundario" href="/contacto">Contacto</Button>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-top: clamp(40px, 8vw, 120px);
  }

  .titulo-pagina {
    margin-top: 18px;
    font-size: clamp(96px, 22vw, 360px);
  }

  .numero {
    display: inline-block;
  }

  .texto {
    margin-top: 32px;
  }

  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
</style>
