---
// Listado de colecciones: una fila por serie con todas sus obras en miniatura.
import Base from '../../layouts/Base.astro'
import ListRow from '../../components/ListRow.astro'
import {getSitio} from '../../lib/contenido'
import {conteo, hrefColeccion, periodo} from '../../lib/derivados'

const {d} = await getSitio()
---

<Base titulo="Colecciones" seccion="colecciones">
  <section class="cabecera contenedor">
    <p class="etiqueta punto">{conteo(d.coleccionesConObras.length, 'serie', 'series')}</p>
    <h1 class="titulo-pagina">Colecciones</h1>
    <p class="parrafo intro">La obra agrupada en series. Cada colección reúne piezas que comparten una búsqueda, un material o un período.</p>
  </section>

  <div class="lista contenedor">
    {d.coleccionesConObras.length === 0 && <p class="vacio">Todavía no hay colecciones publicadas.</p>}
    {
      d.coleccionesConObras.map((c) => {
        const obras = d.obrasDe(c.slug)
        return (
          <ListRow
            href={hrefColeccion(c.slug)}
            nombre={c.nombre}
            numero={d.numeroColeccion(c)}
            meta={[conteo(obras.length, 'obra', 'obras'), periodo(obras)].filter(Boolean).join(' — ')}
            miniaturas={obras.map((o) => o.imagen)}
          />
        )
      })
    }
  </div>
</Base>

<style>
  .cabecera {
    padding-top: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(40px, 5vw, 72px);
  }

  .cabecera .titulo-pagina {
    margin-top: 18px;
  }

  .intro {
    max-width: 52ch;
    margin-top: 28px;
  }

  .lista > :global(:first-child) {
    border-top: 1px solid var(--linea);
  }

  .vacio {
    padding: 32px 0;
    color: var(--tenue);
  }
</style>
