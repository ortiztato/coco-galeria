---
// Una colección: migas, nombre grande, cantidad de obras, período y texto de la serie,
// sus obras a tamaño grande y "Otras colecciones".
import type {GetStaticPaths} from 'astro'
import Base from '../../layouts/Base.astro'
import ObraGrid from '../../components/ObraGrid.astro'
import ObraCard from '../../components/ObraCard.astro'
import ListRow from '../../components/ListRow.astro'
import {getSitio} from '../../lib/contenido'
import {conteo, hrefColeccion, periodo} from '../../lib/derivados'
import {dosCifras} from '../../lib/texto'

export const getStaticPaths = (async () => {
  const {d} = await getSitio()
  return d.coleccionesConObras.map((coleccion) => ({params: {slug: coleccion.slug}, props: {slug: coleccion.slug}}))
}) satisfies GetStaticPaths

const {slug} = Astro.props
const {contenido, d} = await getSitio()
const coleccion = contenido.colecciones.find((c) => c.slug === slug)!
const obras = d.obrasDe(slug)
const otras = d.coleccionesConObras.filter((c) => c.slug !== slug)
const per = periodo(obras)
---

<Base
  titulo={coleccion.nombre}
  seccion="colecciones"
  descripcion={coleccion.texto ?? `${coleccion.nombre}: ${conteo(obras.length, 'obra', 'obras')} de ${contenido.config.nombre}${per ? `, ${per}` : ''}.`}
  imagen={obras[0]?.imagen.src}
>
  <div class="contenedor">
    <nav class="migas" aria-label="Migas de pan">
      <a href="/colecciones">Colecciones</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{coleccion.nombre}</span>
    </nav>
  </div>

  <section class="cabecera contenedor">
    <p class="etiqueta punto">Colección {d.numeroColeccion(coleccion)}</p>
    <h1 class="titulo-pagina">{coleccion.nombre}</h1>
    <div class="info">
      <dl class="stats">
        <div>
          <dt>Obras</dt>
          <dd class="num">{dosCifras(obras.length)}</dd>
        </div>
        {
          per && (
            <div>
              <dt>Período</dt>
              <dd class="num">{per}</dd>
            </div>
          )
        }
      </dl>
      {coleccion.texto && <p class="parrafo texto">{coleccion.texto}</p>}
    </div>
  </section>

  <section class="contenedor" aria-label={`Obras de ${coleccion.nombre}`}>
    <ObraGrid variante="coleccion">
      {obras.map((o, i) => <ObraCard obra={d.resumen(o)} variante="coleccion" eager={i === 0} />)}
    </ObraGrid>
  </section>

  {
    otras.length > 0 && (
      <section class="otras contenedor" aria-labelledby="otras-titulo">
        <h2 id="otras-titulo" class="etiqueta">
          Otras colecciones
        </h2>
        <div class="otras-lista">
          {otras.map((c) => (
            <ListRow variante="compacta" href={hrefColeccion(c.slug)} nombre={c.nombre} meta={conteo(d.obrasDe(c.slug).length, 'obra', 'obras')} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .migas {
    padding-top: 10px;
  }

  .cabecera {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(56px, 7vw, 104px);
  }

  .cabecera .titulo-pagina {
    margin-top: 18px;
  }

  .info {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 28px 64px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--linea);
  }

  .stats {
    display: flex;
    gap: 48px;
  }

  .stats dt {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  .stats dd {
    margin-top: 6px;
    font-family: var(--grotesca);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 30px;
    line-height: 1;
  }

  .texto {
    max-width: 56ch;
  }

  .otras {
    margin-top: clamp(112px, 12vw, 176px);
  }

  .otras-lista {
    margin-top: 12px;
    border-top: 1px solid var(--linea);
  }

  @media (max-width: 767.98px) {
    .info {
      display: block;
      margin-top: 28px;
    }

    .texto {
      margin-top: 20px;
    }

    .stats dd {
      font-size: 24px;
    }
  }
</style>
