---
import Marca from './Marca.astro'
import {navegacion, instagramUrl, type Seccion} from '../lib/sitio'
import {getSitio} from '../lib/contenido'
import {dosCifras} from '../lib/texto'

interface Props {
  actual?: Seccion
}

const {actual} = Astro.props
const {contenido, d} = await getSitio()
const {config} = contenido
const contadores: Partial<Record<Seccion, number>> = {
  obras: d.total,
  colecciones: d.coleccionesConObras.length,
}
---

<header class="header contenedor">
  <a class="nombre grotesca" href="/">{config.nombre}</a>

  <nav class="nav" aria-label="Principal">
    {
      navegacion.map((item) => (
        <a href={item.href} class="con-marca" aria-current={item.id === actual ? 'page' : undefined}>
          {item.label}
          <Marca tipo={item.id === actual ? 'circulo' : 'subrayado'} modo={item.id === actual ? 'fija' : 'hover'} />
        </a>
      ))
    }
  </nav>

  <button type="button" class="menu-abrir" aria-expanded="false" aria-controls="menu-mobile" data-menu-abrir>
    Menú
  </button>
</header>

<div id="menu-mobile" class="menu" role="dialog" aria-modal="true" aria-label="Menú" hidden data-menu>
  <div class="menu-head contenedor">
    <a class="nombre grotesca" href="/">{config.nombre}</a>
    <button type="button" class="menu-cerrar" data-menu-cerrar>Cerrar ✕</button>
  </div>
  <nav class="menu-nav contenedor" aria-label="Principal (menú)">
    {
      navegacion.map((item, i) => (
        <a href={item.href} class="menu-item" aria-current={item.id === actual ? 'page' : undefined}>
          <span class="menu-num num">{dosCifras(i + 1)}</span>
          <span class="menu-texto grotesca con-marca">
            {item.label}
            {item.id === actual && <Marca tipo="circulo" />}
          </span>
          {contadores[item.id] ? <span class="menu-conteo num">{contadores[item.id]}</span> : null}
        </a>
      ))
    }
  </nav>
  <div class="menu-pie contenedor">
    {config.email && <a href={`mailto:${config.email}`}>{config.email}</a>}
    {config.instagram && <a href={instagramUrl(config.instagram)} target="_blank" rel="noopener">Instagram ↗</a>}
  </div>
</div>

<script>
  const abrir = document.querySelector<HTMLButtonElement>('[data-menu-abrir]')
  const cerrar = document.querySelector<HTMLButtonElement>('[data-menu-cerrar]')
  const menu = document.querySelector<HTMLElement>('[data-menu]')
  const mobile = window.matchMedia('(max-width: 767.98px)')

  function setMenu(abierto: boolean) {
    if (!abrir || !menu) return
    menu.hidden = !abierto
    abrir.setAttribute('aria-expanded', String(abierto))
    document.documentElement.style.overflow = abierto ? 'hidden' : ''
    const destino = abierto ? cerrar : abrir
    destino?.focus()
  }

  abrir?.addEventListener('click', () => setMenu(true))
  cerrar?.addEventListener('click', () => setMenu(false))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false)
  })
  // Si la ventana pasa a desktop con el menú abierto, se cierra.
  mobile.addEventListener('change', (e) => {
    if (!e.matches && menu && !menu.hidden) setMenu(false)
  })
</script>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 40px;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .nombre {
    font-size: 17px;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav a {
    color: var(--gris);
    text-decoration: none;
  }

  .nav a:hover,
  .nav a[aria-current] {
    color: var(--blanco);
  }

  .nav :global(.marca--circulo) {
    top: -0.85em;
    left: -1.1em;
    width: calc(100% + 2.2em);
    height: calc(100% + 1.7em);
  }

  .menu-abrir,
  .menu-cerrar {
    display: none;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--linea-fuerte);
    background: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .menu-cerrar {
    display: block;
  }

  /* Panel del menú mobile */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background-color: var(--negro);
    background-image: url(/grano.png);
    background-size: 300px 300px;
  }

  .menu[hidden] {
    display: none;
  }

  .menu-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--linea);
  }

  .menu-nav {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
  }

  .menu-item {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--linea);
    text-decoration: none;
  }

  .menu-num,
  .menu-conteo {
    font-size: 12px;
    color: var(--tenue);
  }

  .menu-texto {
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .menu-conteo {
    margin-left: auto;
  }

  .menu-pie {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    padding-top: 32px;
    padding-bottom: 32px;
    font-size: 13px;
  }

  .menu-pie a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  @media (max-width: 767.98px) {
    .header {
      padding-top: 14px;
      padding-bottom: 14px;
    }

    .nombre {
      font-size: 15px;
    }

    .nav {
      display: none;
    }

    .menu-abrir {
      display: block;
    }
  }
</style>
