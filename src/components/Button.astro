---
// Botón o link con forma de botón, a máquina y en mayúsculas.
//   primario   → blanco papel, texto negro
//   secundario → filete de 1px, fondo transparente
import type {HTMLAttributes} from 'astro/types'

type Props = {
  variante?: 'primario' | 'secundario'
  /** md = 48 px de alto, lg = 56 px. */
  tamano?: 'md' | 'lg'
  /** Ocupa todo el ancho disponible. */
  bloque?: boolean
  href?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type' | 'class'>

const {variante = 'primario', tamano = 'md', bloque = false, href, type = 'button', class: className, ...resto} = Astro.props
const clases = ['btn', `btn--${variante}`, `btn--${tamano}`, {'btn--bloque': bloque}, className]
---

{
  href ? (
    <a class:list={clases} href={href} {...resto}>
      <slot />
    </a>
  ) : (
    <button class:list={clases} type={type} {...resto}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6ch;
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--blanco);
    border-radius: 0;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn--lg {
    min-height: 56px;
    padding: 0 30px;
  }

  .btn--bloque {
    display: flex;
    width: 100%;
  }

  .btn--primario {
    background: var(--blanco);
    color: var(--negro);
  }

  .btn--secundario {
    background: transparent;
    color: var(--blanco);
  }

  @media (hover: hover) {
    .btn--primario:hover {
      background: var(--rojo);
      border-color: var(--rojo);
      color: var(--negro);
    }

    .btn--secundario:hover {
      background: var(--blanco);
      color: var(--negro);
    }
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }
</style>
