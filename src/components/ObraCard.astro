---
// Tarjeta de obra: marco de alto fijo (#121212) con la imagen centrada y sin recorte, y un pie con datos.
// Variantes (valores de los prototipos):
//   home       → marco 360 px, pie con número + año, título 62 px, colección en cian
//   coleccion  → marco 520 px, título 72 px y a la derecha año + técnica
//   mas        → marco 280 px, título 52 px y año ("Más de esta colección")
import ObraImagen from './ObraImagen.astro'
import type {ObraResumen} from '../lib/tipos'

interface Props {
  obra: ObraResumen
  variante?: 'home' | 'coleccion' | 'mas'
  eager?: boolean
}

const {obra, variante = 'home', eager = false} = Astro.props

const sizes = {
  home: '(max-width: 767.98px) 50vw, (max-width: 1400px) 33vw, 25vw',
  coleccion: '(max-width: 767.98px) 100vw, (max-width: 1400px) 50vw, 33vw',
  mas: '(max-width: 767.98px) 50vw, 25vw',
}[variante]
---

<a class:list={['obra-card', `obra-card--${variante}`]} href={obra.href} data-coleccion={obra.coleccion?.slug}>
  <span class="marco">
    <ObraImagen imagen={obra.imagen} sizes={sizes} eager={eager} />
  </span>

  {
    variante === 'home' ? (
      <span class="pie">
        <span class="meta">
          <span>{obra.numero}</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>{obra.anio}</span>
        </span>
        <span class="titulo">{obra.titulo}</span>
        {obra.coleccion && <span class="col">{obra.coleccion.nombre}</span>}
      </span>
    ) : (
      <span class="pie pie-lado">
        <span class="titulo">{obra.titulo}</span>
        <span class="lado">
          {obra.anio}
          {variante === 'coleccion' && obra.tecnica && (
            <>
              <br />
              <span class="tecnica">{obra.tecnica}</span>
            </>
          )}
        </span>
      </span>
    )
  }
</a>

<style>
  .obra-card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }

  .obra-card:hover {
    color: var(--text);
  }

  .marco {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 360px;
    padding: 36px;
    background: var(--frame);
  }

  .obra-card--coleccion .marco {
    height: 520px;
    padding: 48px;
  }

  .obra-card--mas .marco {
    height: 280px;
    padding: 32px;
  }

  .pie {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px 18px;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }

  .meta .sep {
    display: none;
  }

  .titulo {
    font-family: var(--font-display);
    font-size: 62px;
    line-height: 0.95;
    text-transform: uppercase;
    transition: color 0.15s;
  }

  .col {
    font-size: 12px;
    font-weight: 700;
    color: var(--cyan);
    text-transform: uppercase;
  }

  .pie-lado {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .obra-card--coleccion .pie-lado {
    padding: 14px 20px 18px;
  }

  .obra-card--mas .pie-lado {
    padding: 12px 18px 16px;
  }

  .obra-card--coleccion .titulo {
    font-size: 72px;
  }

  .obra-card--mas .titulo {
    font-size: 52px;
  }

  .lado {
    flex: none;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    text-align: right;
    text-transform: uppercase;
  }

  @media (hover: hover) {
    .obra-card:hover .titulo {
      color: var(--pink);
    }
  }

  @media (max-width: 767.98px) {
    /* Home y "más de": 2 columnas */
    .obra-card--home .marco,
    .obra-card--mas .marco {
      height: 180px;
      padding: 18px;
    }

    .obra-card--home .pie {
      padding: 8px 10px 12px;
    }

    .obra-card--home .meta {
      justify-content: flex-start;
      gap: 4px;
      font-size: 10px;
    }

    .obra-card--home .meta .sep {
      display: inline;
    }

    .obra-card--home .titulo,
    .obra-card--mas .titulo {
      font-size: 36px;
    }

    .obra-card--home .col {
      display: none;
    }

    .obra-card--mas .pie-lado {
      padding: 8px 10px 12px;
    }

    /* Colección: 1 columna */
    .obra-card--coleccion .marco {
      height: 300px;
      padding: 28px;
    }

    .obra-card--coleccion .pie-lado {
      padding: 8px 16px 12px;
    }

    .obra-card--coleccion .titulo {
      font-size: 46px;
    }

    .lado {
      font-size: 11px;
    }

    .tecnica {
      display: none;
    }
  }
</style>
