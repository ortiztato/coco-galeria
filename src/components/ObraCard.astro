---
// Obra dentro de una grilla: la imagen entera, con su proporción real y marcas de corte en las
// esquinas; al pasar el mouse, el lápiz rojo la recuadra. Abajo, su ficha a máquina.
// El ancho de cada obra en la fila sale de su proporción (--r), ver ObraGrid.
import ObraImagen from './ObraImagen.astro'
import Marca from './Marca.astro'
import type {ObraResumen} from '../lib/tipos'

interface Props {
  obra: ObraResumen
  /** "mas": versión corta para "Más de esta colección" (sin técnica). */
  variante?: 'home' | 'coleccion' | 'mas'
  eager?: boolean
}

const {obra, variante = 'home', eager = false} = Astro.props
const {imagen} = obra
const proporcion = imagen.width > 0 && imagen.height > 0 ? imagen.width / imagen.height : 1

const sizes = {
  home: '(max-width: 767.98px) 70vw, 34vw',
  coleccion: '(max-width: 767.98px) 90vw, 45vw',
  mas: '(max-width: 767.98px) 60vw, 25vw',
}[variante]
---

<a class:list={['obra-card', `obra-card--${variante}`]} href={obra.href} data-coleccion={obra.coleccion?.slug} style={`--r:${proporcion.toFixed(4)}`}>
  <span class="lienzo corte con-marca">
    <ObraImagen imagen={imagen} sizes={sizes} eager={eager} class="img" />
    <Marca tipo="recuadro" modo="hover" />
  </span>
  <span class="ficha">
    <span class="linea-1">
      {obra.numero && <span class="num numero">{obra.numero}</span>}
      {imagen.color && <span class="muestra" style={`background:${imagen.color}`} />}
      {obra.anio ? <span class="num anio">{obra.anio}</span> : null}
    </span>
    <span class="titulo">{obra.titulo}</span>
    {
      variante !== 'mas' && (obra.tecnica || obra.medidas) && (
        <span class="detalle">
          {obra.tecnica}
          {obra.tecnica && obra.medidas && ' — '}
          {obra.medidas && <span class="medidas num">{obra.medidas}</span>}
        </span>
      )
    }
  </span>
</a>

<style>
  .obra-card {
    /* Ancho base = proporción × alto de fila; crece en la misma proporción para llenar la fila
       (así todas las obras de una fila quedan del mismo alto), hasta un tope (--crecer). */
    flex: var(--r) 1 calc(var(--r) * var(--alto-fila));
    max-width: calc(var(--r) * var(--alto-fila) * var(--crecer, 1.6));
    min-width: 0;
    display: flex;
    flex-direction: column;
    color: var(--blanco);
    text-decoration: none;
  }

  .obra-card[hidden] {
    display: none;
  }

  .lienzo {
    display: block;
  }

  .lienzo :global(.img) {
    width: 100%;
    max-height: none;
  }

  .ficha {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 18px;
  }

  .linea-1 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--tenue);
  }

  .numero {
    color: var(--blanco);
  }

  .titulo {
    font-family: var(--grotesca);
    font-stretch: 118%;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .detalle {
    font-size: 12px;
    line-height: 1.5;
    color: var(--tenue);
  }

  .medidas {
    white-space: nowrap;
  }

  .obra-card--coleccion .titulo {
    font-size: 16px;
  }

  .obra-card:focus-visible .lienzo > :global(.marca--hover) {
    clip-path: inset(0 0 0 0);
  }

  @media (hover: hover) {
    .obra-card:hover .lienzo > :global(.marca--hover) {
      clip-path: inset(0 0 0 0);
    }

    .obra-card:hover .titulo {
      text-decoration: underline;
      text-decoration-color: var(--rojo);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.3em;
    }
  }

  @media (max-width: 767.98px) {
    .ficha {
      padding-top: 14px;
    }

    .titulo {
      font-size: 12.5px;
    }

    .detalle {
      font-size: 11px;
    }
  }
</style>
