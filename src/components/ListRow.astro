---
// Fila de listado de ancho completo, separada por filetes.
//   coleccion → listado de colecciones: número, nombre grande, "4 obras — 2020—2023",
//               una tira con todas sus obras (enteras, a la misma altura) y una flecha
//   compacta  → "Otras colecciones": nombre y conteo
import ObraImagen from './ObraImagen.astro'
import Marca from './Marca.astro'
import type {Imagen} from '../lib/tipos'

interface Props {
  href: string
  nombre: string
  /** Texto de metadatos, ej. "4 obras — 2020—2023". */
  meta: string
  numero?: string
  miniaturas?: Imagen[]
  variante?: 'coleccion' | 'compacta'
}

const {href, nombre, meta, numero, miniaturas = [], variante = 'coleccion'} = Astro.props
---

{
  variante === 'coleccion' ? (
    <a class="list-row" href={href}>
      {numero && <span class="num numero">{numero}</span>}
      <span class="cuerpo">
        <span class="nombre grotesca con-marca">
          {nombre}
          <Marca tipo="subrayado" modo="hover" />
        </span>
        <span class="meta">{meta}</span>
      </span>
      {miniaturas.length > 0 && (
        <span class="tira">
          {miniaturas.map((m) => (
            <ObraImagen imagen={m} sizes="160px" decorativa class="mini" />
          ))}
        </span>
      )}
      <span class="flecha" aria-hidden="true">
        <Marca tipo="flecha" />
      </span>
    </a>
  ) : (
    <a class="list-row-c" href={href}>
      <span class="nombre-c grotesca con-marca">
        {nombre}
        <Marca tipo="subrayado" modo="hover" />
      </span>
      <span class="meta-c">{meta}</span>
    </a>
  )
}

<style>
  .list-row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto 56px;
    align-items: center;
    gap: 24px 32px;
    padding: 30px 0;
    border-bottom: 1px solid var(--linea);
    color: var(--blanco);
    text-decoration: none;
  }

  .numero {
    align-self: start;
    padding-top: 0.6em;
    font-size: 12px;
    color: var(--tenue);
  }

  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .nombre {
    align-self: flex-start;
    font-size: clamp(30px, 4.4vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.015em;
  }

  .nombre :global(.marca--subrayado) {
    bottom: -0.2em;
    height: 0.2em;
    stroke-width: 3px;
  }

  .meta {
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  .tira {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    max-width: 50vw;
    overflow: hidden;
  }

  .tira :global(.mini) {
    flex: none;
    width: auto;
    height: 84px;
    max-width: none;
    max-height: none;
  }

  .flecha {
    justify-self: end;
    width: 48px;
    font-size: 26px;
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  @media (hover: hover) {
    .list-row:hover .flecha {
      opacity: 1;
      transform: none;
    }

    .list-row:hover .nombre > :global(.marca--hover) {
      clip-path: inset(0 0 0 0);
    }
  }

  .list-row:focus-visible .flecha {
    opacity: 1;
    transform: none;
  }

  /* Compacta */
  .list-row-c {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--linea);
    text-decoration: none;
  }

  .nombre-c {
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .meta-c {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  @media (hover: hover) {
    .list-row-c:hover .nombre-c > :global(.marca--hover) {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 767.98px) {
    .list-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: 24px 0;
    }

    .numero,
    .flecha {
      display: none;
    }

    .tira {
      max-width: none;
      gap: 10px;
    }

    .tira :global(.mini) {
      height: 60px;
    }
  }
</style>
