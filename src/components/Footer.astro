---
import Overprint from './Overprint.astro'
import {sitio, instagramUrl} from '../lib/sitio'

interface Props {
  /** "corto": versión de una línea que usa la página de contacto. */
  variante?: 'completo' | 'corto'
}

const {variante = 'completo'} = Astro.props
const anio = new Date().getFullYear()
const copy = `© ${anio} ${sitio.nombre.toUpperCase()}`
---

{
  variante === 'completo' ? (
    <footer class="footer">
      <a class="cta" href="/contacto" aria-label="Contacto">
        <Overprint
          text="Contacto →"
          size="clamp(140px, 15vw, 220px)"
          height="clamp(140px, 14.6vw, 212px)"
          mobileSize="110px"
          mobileHeight="110px"
          offset={[12, 8]}
          mobileOffset={[8, 6]}
        />
      </a>
      <div class="datos">
        <a href={instagramUrl(sitio.instagram)} target="_blank" rel="noopener">Instagram ↗</a>
        <a href={`mailto:${sitio.email}`}>{sitio.email}</a>
        <span class="copy">{copy}</span>
      </div>
    </footer>
  ) : (
    <footer class="footer-corto">
      <span class="copy">{copy}</span>
      <span class="links">
        <a href={instagramUrl(sitio.instagram)} target="_blank" rel="noopener">Instagram ↗</a>
        <a href="/">Obras</a>
        <a href="/acerca">Acerca de</a>
      </span>
    </footer>
  )
}

<style>
  .footer {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    padding: 36px var(--gutter);
  }

  .cta {
    display: block;
    width: min(720px, 100%);
    text-decoration: none;
  }

  .datos {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .copy {
    color: var(--muted);
  }

  .footer-corto {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 20px;
    padding: 24px var(--gutter);
    border-top: 1px solid var(--line);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .links {
    display: flex;
    gap: 24px;
  }

  @media (max-width: 767.98px) {
    .footer {
      padding: 28px var(--gutter);
    }

    .datos {
      align-items: flex-start;
      gap: 0;
      font-size: 12px;
    }

    .datos a,
    .links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .footer-corto {
      font-size: 12px;
    }
  }
</style>
