---
import Marca from './Marca.astro'
import {instagramUrl} from '../lib/sitio'
import {getSitio} from '../lib/contenido'

interface Props {
  /** "corto": sólo la línea final (la usa la página de contacto). */
  variante?: 'completo' | 'corto'
}

const {variante = 'completo'} = Astro.props
const {contenido, d} = await getSitio()
const {config} = contenido
const anio = new Date().getFullYear()
const borde = [config.nombre, 'Artista visual', config.ciudad, d.periodoGeneral && `Obra ${d.periodoGeneral}`].filter(Boolean)
---

<footer class="footer">
  {
    variante === 'completo' && (
      <div class="contenedor arriba">
        <p class="etiqueta">Consultas · exposiciones · prensa</p>
        <a href="/contacto" class="escribime grotesca con-marca">
          Escribime <Marca tipo="flecha" />
          <Marca tipo="subrayado" modo="hover" />
        </a>
      </div>
    )
  }
  <p class="borde contenedor" aria-hidden="true">
    {
      borde.map((t, i) => (
        <>
          {i > 0 && <span class="sep">▸</span>}
          <span>{t}</span>
        </>
      ))
    }
  </p>
  <div class="contenedor abajo">
    <span class="copy">© {anio} {config.nombre}</span>
    <span class="links">
      {config.email && <a href={`mailto:${config.email}`}>{config.email}</a>}
      {
        config.instagram && (
          <a href={instagramUrl(config.instagram)} target="_blank" rel="noopener">
            Instagram ↗
          </a>
        )
      }
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding-top: clamp(96px, 12vw, 176px);
  }

  .arriba {
    padding-top: 28px;
    padding-bottom: 40px;
    border-top: 1px solid var(--linea);
  }

  .escribime {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    margin-top: 14px;
    font-size: clamp(44px, 8vw, 140px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .escribime :global(.marca--flecha) {
    stroke-width: 3px;
  }

  /* Texto de borde de película */
  .borde {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-top: 1px solid var(--linea);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  .sep {
    color: var(--rojo);
  }

  .abajo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 14px;
    padding-bottom: 28px;
    border-top: 1px solid var(--linea);
    font-size: 12px;
    color: var(--tenue);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    color: var(--blanco);
    text-decoration: underline;
  }

  @media (max-width: 767.98px) {
    .escribime {
      flex-wrap: wrap;
      max-width: 100%;
      font-size: clamp(28px, 8.6vw, 44px);
    }

    .abajo {
      flex-direction: column;
    }

    .links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
