---
// Selector de una opción (filtro de la home, motivo del formulario), a máquina.
// La opción elegida queda encerrada con lápiz rojo. Un solo botón activo a la vez, con aria-pressed.
// Al cambiar dispara el evento "chips:cambio" en el contenedor, con detail = {valor}.
import Marca from './Marca.astro'

interface Opcion {
  valor: string
  label: string
  conteo?: number
}

interface Props {
  opciones: Opcion[]
  activo?: string
  /** Nombre accesible del grupo, ej. "Filtrar por colección". */
  etiqueta: string
  /** Rótulo visible a la izquierda, ej. "Ver". */
  etiquetaVisible?: string
  /** En mobile, las opciones bajan de línea en vez de deslizarse de costado. */
  envolver?: boolean
  id?: string
  class?: string
}

const {opciones, activo = opciones[0]?.valor, etiqueta, etiquetaVisible, envolver = false, id, class: className} = Astro.props
---

<div class:list={['filter-chips', {'filter-chips--envolver': envolver}, className]} role="group" aria-label={etiqueta} id={id} data-chips>
  {etiquetaVisible && <span class="rotulo" aria-hidden="true">{etiquetaVisible}</span>}
  {
    opciones.map((o) => (
      <button type="button" class="chip" aria-pressed={o.valor === activo ? 'true' : 'false'} data-valor={o.valor}>
        <span class="texto con-marca">
          {o.label}
          <Marca tipo="circulo" class="marca-chip" />
        </span>
        {o.conteo !== undefined && <span class="conteo num">{o.conteo}</span>}
      </button>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-chips]').forEach((grupo) => {
    grupo.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip')
      if (!chip || chip.getAttribute('aria-pressed') === 'true') return
      grupo.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)))
      grupo.dispatchEvent(new CustomEvent('chips:cambio', {detail: {valor: chip.dataset.valor}, bubbles: true}))
    })
  })
</script>

<style>
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 34px;
  }

  .rotulo {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  .chip {
    display: inline-flex;
    align-items: flex-start;
    gap: 5px;
    min-height: 44px;
    padding: 13px 0;
    border: 0;
    background: none;
    color: var(--gris);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .chip:hover,
  .chip[aria-pressed='true'] {
    color: var(--blanco);
  }

  /* El círculo rojo sólo en la opción elegida; se dibuja al elegirla. */
  .chip :global(.marca-chip) {
    display: none;
  }

  .chip[aria-pressed='true'] :global(.marca-chip) {
    display: block;
  }

  .chip :global(.marca-chip) {
    top: -0.8em;
    left: -0.95em;
    width: calc(100% + 1.9em);
    height: calc(100% + 1.6em);
  }

  .conteo {
    font-size: 10px;
    line-height: 1;
    color: var(--tenue);
  }

  @media (max-width: 767.98px) {
    /* En mobile las opciones van en una fila que se desliza de costado. */
    .filter-chips {
      flex-wrap: nowrap;
      gap: 0 30px;
      padding-inline: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .filter-chips::-webkit-scrollbar {
      display: none;
    }

    .filter-chips--envolver {
      flex-wrap: wrap;
      overflow-x: visible;
      padding-inline: 10px;
    }

    .rotulo {
      display: none;
    }

    .chip {
      flex: none;
    }
  }
</style>
