---
// Ficha técnica de la obra, a máquina: rótulo a la izquierda y dato a la derecha, separados por filetes.
interface Dato {
  etiqueta: string
  valor: string
  href?: string
}

interface Props {
  datos: Dato[]
  class?: string
}

const {datos, class: className} = Astro.props
---

<dl class:list={['data-list', className]}>
  {
    datos.map((d) => (
      <div class="fila">
        <dt>{d.etiqueta}</dt>
        <dd>{d.href ? <a href={d.href}>{d.valor}</a> : d.valor}</dd>
      </div>
    ))
  }
</dl>

<style>
  .data-list {
    border-top: 1px solid var(--linea);
  }

  .fila {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--linea);
    font-size: 13px;
    line-height: 1.5;
  }

  dt {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tenue);
    padding-top: 2px;
  }

  @media (max-width: 767.98px) {
    .fila {
      grid-template-columns: 96px minmax(0, 1fr);
    }
  }
</style>
