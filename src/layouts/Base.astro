---
import '@fontsource/six-caps'
import '@fontsource/jetbrains-mono/400.css'
import '@fontsource/jetbrains-mono/700.css'
import '../styles/global.css'

import Marquee from '../components/Marquee.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {type Seccion} from '../lib/sitio'
import {getSitio} from '../lib/contenido'
import {resumir} from '../lib/texto'

interface Props {
  /** Título de la página (sin el nombre del artista). */
  titulo?: string
  /** Meta descripción. Si no se pasa, se usa la de "Datos del sitio". */
  descripcion?: string
  /** Imagen para compartir (Open Graph). Si no se pasa, la de "Datos del sitio" o la primera obra. */
  imagen?: string
  /** Para que los buscadores no la indexen (ej. 404). */
  noindex?: boolean
  /** Sección activa en la navegación. */
  seccion?: Seccion
  /** Frases de la marquesina de esta página. */
  marquesina: string[]
  footer?: 'completo' | 'corto'
}

const {titulo, descripcion, imagen, noindex = false, seccion, marquesina, footer = 'completo'} = Astro.props
const {contenido} = await getSitio()
const {config, obras} = contenido
const tituloCompleto = titulo ? `${titulo} — ${config.nombre}` : config.nombre

const descripcionPorDefecto =
  config.seoDescripcion ??
  [`${config.nombre}, artista visual${config.ciudad ? ` de ${config.ciudad}` : ''}.`, config.disciplinas].filter(Boolean).join(' ')
const descripcionFinal = resumir(descripcion ?? descripcionPorDefecto, 160)

const sitio = Astro.site ?? new URL('http://localhost:4321')
const canonical = new URL(Astro.url.pathname, sitio).href
const imagenRelativa = imagen ?? config.imagenCompartir?.src ?? obras[0]?.imagen.src
const imagenOg = imagenRelativa ? new URL(imagenRelativa, sitio).href : undefined
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcionFinal} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Al compartir en redes -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={config.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcionFinal} />
    <meta property="og:url" content={canonical} />
    {imagenOg && <meta property="og:image" content={imagenOg} />}
    <meta name="twitter:card" content={imagenOg ? 'summary_large_image' : 'summary'} />
  </head>
  <body class="grain">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="pagina">
      <Marquee items={marquesina} />
      <Header actual={seccion} />
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
      <Footer variante={footer} />
    </div>
  </body>
</html>

<style>
  .pagina {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  main {
    display: flex;
    flex-direction: column;
  }

  main:focus {
    outline: none;
  }
</style>
