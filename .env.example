# Copiá este archivo como .env y completá los valores. .env no se sube al repo.

# sanity.io/manage → tu proyecto → Project ID
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# web3forms.com → Access Key (es pública por diseño de Web3Forms)
PUBLIC_WEB3FORMS_KEY=

# Sólo para importar contenido (npm run importar). sanity.io/manage → API → Tokens, permiso Editor.
# Borralo de Sanity cuando termines de importar.
SANITY_WRITE_TOKEN=

# Opcional: 1 = usar el contenido de prueba (content/obras-ejemplo.csv) en vez de Sanity.
# Sirve para trabajar sin conexión o comparar con el diseño. Nunca en producción.
CONTENIDO_PRUEBA=
